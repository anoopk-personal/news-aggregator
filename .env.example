# === LLM Configuration ===
# Uncomment ONE provider block below and fill in your values.
# Then: cp .env.example .env && edit .env

# --- Ollama (local, free) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# --- OpenAI ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# --- OpenRouter ---
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-pro

# --- LiteLLM Proxy ---
# LLM_API_KEY=your-litellm-key
# LLM_BASE_URL=https://your-litellm-proxy.example.com
# LLM_MODEL=gemini-2.5-pro
