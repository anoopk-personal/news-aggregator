#!/usr/bin/env bash
# Pre-commit hook: enforce that a git email address is configured.
# Rejects commits with empty or default/example email addresses.
# Install with: make install-hooks

set -euo pipefail

CURRENT_EMAIL=$(git config user.email 2>/dev/null || echo "")

if [ -z "$CURRENT_EMAIL" ]; then
    echo "ERROR: git user.email is not configured."
    echo "Set your email with: git config user.email <your-email>"
    exit 1
fi

# Reject obvious placeholder or unconfigured emails
if [[ "$CURRENT_EMAIL" =~ @example\.com$ ]] || [[ "$CURRENT_EMAIL" == "you@yours.com" ]]; then
    echo "ERROR: git user.email '${CURRENT_EMAIL}' looks like a placeholder."
    echo "Set your real email with: git config user.email <your-email>"
    exit 1
fi

exit 0
